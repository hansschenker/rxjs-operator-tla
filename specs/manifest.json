  { "module": "ForkJoin",      "cfg": "ForkJoin_emptySource_demo.cfg",  "expect": "liveness-violation", "family": "combining",   "note": "liveness demo: completes without a value if a source completes empty" },
  { "module": "SearchAndSave", "cfg": "SearchAndSave.cfg",              "expect": "success",            "family": "composition", "note": "terms$.pipe(switchMap(search), concatMap(save))" },
  { "module": "SearchAndSave", "cfg": "SearchAndSave_bug_mergeSearch.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: mergeMap for the searches saves a stale result last" },
  { "module": "SearchAndSave", "cfg": "SearchAndSave_bug_switchSave.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: switchMap for the saves cancels a save in flight (lost write)" },
  { "module": "SearchAndSave", "cfg": "SearchAndSave_bug_mergeSave.cfg", "expect": "invariant-violation","family": "composition", "note": "bug demo: mergeMap for the saves lets writes overlap" },
  { "module": "SearchAndSave", "cfg": "SearchAndSave_bug_exhaustSave.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: exhaustMap for the saves drops a result" },
  { "module": "RetryOnShare",  "cfg": "RetryOnShare_before.cfg",         "expect": "success",            "family": "composition", "note": "source$.pipe(retry(2), share()): one retry for everyone" },
  { "module": "RetryOnShare",  "cfg": "RetryOnShare_after.cfg",          "expect": "success",            "family": "composition", "note": "shared$.pipe(retry(2)) on one subscription: a retry per subscription" },
  { "module": "RetryOnShare",  "cfg": "RetryOnShare_after_demo.cfg",     "expect": "invariant-violation","family": "composition", "note": "demo: retry after share does not protect the other subscriptions" },
  { "module": "RetryOnShare",  "cfg": "RetryOnShare_noReset_demo.cfg",   "expect": "invariant-violation","family": "composition", "note": "demo: retry after share({resetOnError: false}) exhausts without re-executing the source" },
  { "module": "CatchInSwitchMap", "cfg": "CatchInSwitchMap_inside.cfg",  "expect": "success",            "family": "composition", "note": "switchMap(t => search(t).pipe(catchError(...))): a failed search is replaced, the outer carries on" },
  { "module": "CatchInSwitchMap", "cfg": "CatchInSwitchMap_outside.cfg", "expect": "success",            "family": "composition", "note": "switchMap(search), catchError(...): the first failed search ends the pipeline" },
  { "module": "CatchInSwitchMap", "cfg": "CatchInSwitchMap_bug_outsideStops.cfg",     "expect": "invariant-violation", "family": "composition", "note": "bug demo: catchError outside switchMap unsubscribes from the terms on the first failed search" },
  { "module": "CatchInSwitchMap", "cfg": "CatchInSwitchMap_bug_outsideCompletes.cfg", "expect": "invariant-violation", "family": "composition", "note": "bug demo: catchError outside switchMap completes the output while the terms are still active" },
  { "module": "RetryThenCatch", "cfg": "RetryThenCatch.cfg",                    "expect": "success",            "family": "composition", "note": "source$.pipe(retry(2), catchError(sel)): three attempts, then the fallback once" },
  { "module": "RetryThenCatch", "cfg": "RetryThenCatch_reversed.cfg",           "expect": "success",            "family": "composition", "note": "source$.pipe(catchError(sel), retry(2)): the fallback on every error, retry only on fallback errors" },
  { "module": "RetryThenCatch", "cfg": "RetryThenCatch_bug_reversedNoRetry.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: catchError before retry: the fallback completes the stream, the source is never retried" },
  { "module": "RetryThenCatch", "cfg": "RetryThenCatch_bug_reversedRepeats.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: catchError before retry: the fallback runs on every source error" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_take1.cfg",             "expect": "success",            "family": "composition", "note": "forkJoin([a$, b$.pipe(take(1))]) against a B that never completes" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_none_chatty_demo.cfg",  "expect": "liveness-violation", "family": "composition", "note": "liveness demo: no guard, B keeps delivering and never completes: the hang" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_take1_silent_demo.cfg", "expect": "liveness-violation", "family": "composition", "note": "liveness demo: take(1) against a B that never delivers: still a hang" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_timer.cfg",             "expect": "success",            "family": "composition", "note": "forkJoin([a$, b$.pipe(takeUntil(timer(2)))]) against a silent B" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_timer_empty_demo.cfg",  "expect": "invariant-violation","family": "composition", "note": "demo: takeUntil(timer) completes an empty branch, so forkJoin completes without a value" },
  { "module": "ForkJoinGuarded", "cfg": "ForkJoinGuarded_timerDefault.cfg",      "expect": "success",            "family": "composition", "note": "forkJoin([a$, b$.pipe(takeUntil(timer(2)), defaultIfEmpty(d))]): terminates and always has a value" },
  { "module": "SearchAndSaveTimed", "cfg": "SearchAndSaveTimed.cfg",             "expect": "success",            "family": "composition", "note": "timed saves with retry(1) on the inner: the queue waits, acknowledgement latency is bounded" },
  { "module": "SearchAndSaveTimed", "cfg": "SearchAndSaveTimed_catch.cfg",       "expect": "success",            "family": "composition", "note": "timed saves with catchError(() => EMPTY) on the inner: a failed save is skipped" },
  { "module": "SearchAndSaveTimed", "cfg": "SearchAndSaveTimed_bug_propagate.cfg","expect": "invariant-violation","family": "composition", "note": "bug demo: no handling on the inner save: the first failure errors the pipeline and cancels the queue" },
  { "module": "SearchAndSaveTimed", "cfg": "SearchAndSaveTimed_bug_catchSkips.cfg","expect": "invariant-violation","family": "composition", "note": "demo: catchError(() => EMPTY) on the inner save completes with writes silently missing" },
  { "module": "SearchAndSaveTimed", "cfg": "SearchAndSaveTimed_bug_latency.cfg", "expect": "invariant-violation","family": "composition", "note": "demo: the latency bound that forgets retries fails: a retried save delays everything behind it" }
]
