[
  { "module": "Take",          "cfg": "Take.cfg",                       "expect": "success",            "family": "truncating",  "note": "take(N)" },
  { "module": "Pointwise",     "cfg": "Pointwise.cfg",                  "expect": "success",            "family": "pointwise",   "note": "map, filter, scan, distinctUntilChanged" },
  { "module": "Flatten",       "cfg": "Flatten_switch.cfg",             "expect": "success",            "family": "flattening",  "note": "switchMap" },
  { "module": "Flatten",       "cfg": "Flatten_merge.cfg",              "expect": "success",            "family": "flattening",  "note": "mergeMap" },
  { "module": "Flatten",       "cfg": "Flatten_concat.cfg",             "expect": "success",            "family": "flattening",  "note": "concatMap" },
  { "module": "Flatten",       "cfg": "Flatten_exhaust.cfg",            "expect": "success",            "family": "flattening",  "note": "exhaustMap" },
  { "module": "Flatten",       "cfg": "Flatten_bug_mergeForSwitch.cfg", "expect": "invariant-violation","family": "flattening",  "note": "bug demo: mergeMap where switchMap was intended" },
  { "module": "Flatten",       "cfg": "Flatten_stall_concat.cfg",       "expect": "liveness-violation", "family": "flattening",  "note": "liveness demo: concatMap stalls behind an inner that never completes" },
  { "module": "DebounceTime",  "cfg": "DebounceTime.cfg",               "expect": "success",            "family": "timing",      "note": "debounceTime(D)" },
  { "module": "CancelAfter",   "cfg": "CancelAfter.cfg",                "expect": "success",            "family": "timing",      "note": "custom cancelAfter(D) = takeUntil(timer(D))" },
  { "module": "Pipeline",      "cfg": "Pipeline.cfg",                   "expect": "success",            "family": "composition", "note": "source.pipe(filter(P), take(N))" },
  { "module": "CombineLatest", "cfg": "CombineLatest.cfg",              "expect": "success",            "family": "combining",   "note": "combineLatest([a$, b$])" },
  { "module": "CombineLatest", "cfg": "CombineLatest_SilentB.cfg",      "expect": "liveness-violation", "family": "combining",   "note": "liveness demo: hangs when source B is not fair" },
  { "module": "CombineLatest", "cfg": "CombineLatest_EmptySource.cfg",  "expect": "liveness-violation", "family": "combining",   "note": "liveness demo: never emits if a source terminates before the pair forms" },
  { "module": "Share",         "cfg": "Share.cfg",                      "expect": "success",            "family": "multicasting","note": "share()" },
  { "module": "Share",         "cfg": "Share_replay.cfg",               "expect": "success",            "family": "multicasting","note": "shareReplay(1)" },
  { "module": "Share",         "cfg": "Share_replayRefCount.cfg",       "expect": "success",            "family": "multicasting","note": "shareReplay({bufferSize: 1, refCount: true})" },
  { "module": "Share",         "cfg": "Share_leak_demo.cfg",            "expect": "invariant-violation","family": "multicasting","note": "demo: shareReplay keeps the source running after the last subscription leaves" },
  { "module": "Share",         "cfg": "Share_restart_demo.cfg",         "expect": "invariant-violation","family": "multicasting","note": "demo: share() re-executes the source for a subscription after a reset" },
  { "module": "Retry",         "cfg": "Retry.cfg",                      "expect": "success",            "family": "error-handling","note": "retry(2)" },
  { "module": "Retry",         "cfg": "Retry_resetOnSuccess.cfg",       "expect": "success",            "family": "error-handling","note": "retry({count: 1, resetOnSuccess: true})" },
  { "module": "Retry",         "cfg": "Retry_delay.cfg",                "expect": "success",            "family": "error-handling","note": "retry({count: 2, delay: 2})" },
  { "module": "Retry",         "cfg": "Retry_partial_demo.cfg",         "expect": "invariant-violation","family": "error-handling","note": "demo: values of failed attempts reach the subscriber before the final error" },
  { "module": "CatchError",    "cfg": "CatchError.cfg",                 "expect": "success",            "family": "error-handling","note": "catchError(selector), any fallback" },
  { "module": "CatchError",    "cfg": "CatchError_fallbackError_demo.cfg","expect": "invariant-violation","family": "error-handling","note": "demo: an error in the fallback is not caught" },
  { "module": "Zip",           "cfg": "Zip.cfg",                        "expect": "success",            "family": "combining",   "note": "zip(a$, b$)" },
  { "module": "Zip",           "cfg": "Zip_buffer_demo.cfg",            "expect": "invariant-violation","family": "combining",   "note": "demo: zip buffers without bound" },
  { "module": "Zip",           "cfg": "Zip_notLatest_demo.cfg",         "expect": "invariant-violation","family": "combining",   "note": "demo: zip pairs by position, not recency (combineLatest's invariant fails)" },
  { "module": "ForkJoin",      "cfg": "ForkJoin.cfg",                   "expect": "success",            "family": "combining",   "note": "forkJoin(a$, b$)" },
