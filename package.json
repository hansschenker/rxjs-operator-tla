{
  "name": "rxjs-operator-tla",
  "version": "0.1.0",
  "private": true,
  "description": "RxJS operator behaviour described in TLA+ and checked with the TLC and tla-ts model checkers",
  "type": "module",
  "scripts": {
    "check": "node scripts/check.mjs",
    "check:trace": "node scripts/check.mjs --trace",
    "check:tlc": "node scripts/check.mjs --engine tlc",
    "check:both": "node scripts/check.mjs && node scripts/check.mjs --engine tlc",
    "trace": "node scripts/trace-to-marble.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "rxjs": "^7.8.2",
    "tla-ts": "0.0.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
